# i3 config file (v4)
#
# Please see https://i3wm.org/docs/userguide.html for a complete reference!

### Variables
#
    # Logo key. Use Mod1 for Alt.
    set $mod Mod4
    set $alt Mod1

    # Font used for the window titles and bar {} below
    set $font pango:DejaVu Sans

    # Scripts
    set $focus_or_open_by_class ~/.local/bin/focus-or-open-by-window-class
    set $focus_or_open_by_title ~/.local/bin/focus-or-open-by-window-title

    # Monitor aliases
    set $left_monitor "HDMI-A-0"
    set $center_monitor "DisplayPort-0"
    set $right_monitor "DisplayPort-1"

    # Define names for default workspaces for which we configure key bindings later on.
    # We use variables to avoid repeating the names in multiple places.
    set $ws1 "1"
    set $ws2 "2"
    set $ws3 "3"
    set $ws4 "4"
    set $ws5 "5"
    set $ws6 "6"
    set $ws7 "7"
    set $ws8 "8"
    set $ws9 "9"
    set $ws10 "10"

    # Define names for non-numbered side workspaces
    set $ws_left left
    set $ws_right right

    # Application Command and Window Class Variables
    #   * Note: find window class via wmctrl or xprop
    set $1password_cmd "1password"
    set $1password_class "1password"

    set $brave_browser_cmd "brave-browser"
    set $brave_browser_class "Brave-browser"

    set $calculator_cmd "gnome-calculator"
    set $calculator_class "Gnome-calculator"

    set $calibre_cmd "calibre"
    set $calibre_class "calibre"

    set $discord_cmd "flatpak run com.discordapp.Discord"
    set $discord_class "discord"

    set $helium_cmd "helium"
    set $helium_class "helium"

    set $gnome_parted_cmd "gnome-parted"
    set $gnome_parted_class "Gnome-parted"

    set $ghostty_terminal_cmd "ghostty"
    set $ghostty_terminal_class "ghostty"

    set $librewolf_cmd "librewolf"
    set $librewolf_class "librewolf"

    set $lotion_cmd "lotion"
    set $lotion_class "lotion"

    set $kde_connect_sms_cmd "kdeconnect-sms"
    set $kde_connect_sms_class "kdeconnect.sms"

    set $pika_backup_cmd "flatpak run org.gnome.World.PikaBackup"
    set $pika_backup_class "pika-backup"

    set $proton_mail_cmd "proton-mail"
    set $proton_mail_class "proton-mail"

    set $proton_pass_cmd "proton-pass"
    set $proton_pass_class "proton-pass"

    set $proton_vpn_cmd "protonvpn-app"
    set $proton_vpn_class "Protonvpn-app"

    set $qprompt_cmd "flatpak run com.cuperino.qprompt"
    set $qprompt_class "qprompt"

    set $snapchat_cmd ""
    set $snapchat_title "Snapchat"

    set $steam_cmd "steam"
    set $steam_class "steam"

    set $steam_app_cmd ""
    set $steam_app_class "^steam_app_[0-9]+$"

    set $teleprompter_cmd "flatpak run io.github.nokse22.teleprompter"
    set $teleprompter_class "teleprompter"

    set $vifm_cmd "ghostty --title=vifm -e vifm"
    set $vifm_class "ghostty"
    set $vifm_title "vifm"

    set $yazi_cmd "ghostty --title=yazi -e yazi"
    set $yazi_class "ghostty"
    set $yazi_title "yazi"

    set $youtube_cmd ""
    set $youtube_class "WebApp-Youtube2592"

    set $zen_browser_cmd "flatpak run app.zen_browser.zen"
    set $zen_browser_class "zen"

    set $zoom_cmd "zoom"
    set $zoom_class "zoom"

### Appearance
#
# Font:
#
    # Font for window titles. Will also be used by the bar unless a different font
    # is used in the bar {} block below.
    font $font 18
#
# Gaps:
#
    # Enabling "Smart Gaps" means no gaps will be shown where
    # there is one window
    smart_gaps off
    # Inner gaps for all windows: space between two adjacent windows (or split containers)
    gaps inner 20
    # Outer gaps for all windws: space along the screen edges
    gaps outer 10
#
# Colors:
#
    # Color schemes for windows
    #   - alter transparency via this guide:
    #     https://gist.github.com/lopspower/03fb1cc0ac9f32ef38f4?ref=itsfoss.com
    set $text        #e3eaf2
    set $bar-color   #171a2199

    # focused container and workspaces colors
    set $focused-bg  #6a8bb2b3
    set $focused-ws  #789bbdb3

    # inactive background and text colors
    set $in-bgcolor  #2a2f3a66
    set $in-text     #9099a666

    # urgent background colors
    set $u-bgcolor   #d95f5f
    set $indicator   #4a5568
#
# Window colors:
#
    # class                 border        background    text       indicator
    client.focused          $focused-bg   $focused-bg   $text      $indicator
    client.unfocused        $in-bgcolor   $in-bgcolor   $in-text   $in-bgcolor
    client.focused_inactive $in-bgcolor   $in-bgcolor   $in-text   $in-bgcolor
    client.urgent           $u-bgcolor    $u-bgcolor    $text      $u-bgcolor
#
# Bar colors:
#
    # Start i3bar to display a workspace bar (plus the system information i3status
    # finds out, if available)
    bar {
        font $font 18
        status_command i3status -c /home/$USER/.config/i3status/i3status.conf
        colors {
                background $bar-color
                separator #191919
                #                       border          background      text
                focused_workspace       $focused-ws     $focused-ws     $text
                inactive_workspace      $in-bgcolor     $in-bgcolor     $text
                urgent_workspace        $u-bgcolor      $u-bgcolor      $text
        }
        i3bar_command i3bar --transparency
        tray_output primary
        tray_padding 6
    }

### Keybindings
#
#
# Basics:
#
    # Use pactl to adjust volume in PulseAudio.
    set $refresh_i3status killall -SIGUSR1 i3status
    bindsym XF86AudioRaiseVolume exec --no-startup-id pactl set-sink-volume @DEFAULT_SINK@ +10% && $refresh_i3status
    bindsym XF86AudioLowerVolume exec --no-startup-id pactl set-sink-volume @DEFAULT_SINK@ -10% && $refresh_i3status
    bindsym XF86AudioMute exec --no-startup-id pactl set-sink-mute @DEFAULT_SINK@ toggle && $refresh_i3status
    bindsym XF86AudioMicMute exec --no-startup-id pactl set-source-mute @DEFAULT_SOURCE@ toggle && $refresh_i3status

    # start a terminal
    bindsym $mod+Return exec i3-sensible-terminal

    # Lock the screen
    bindsym $mod+$alt+l exec --no-startup-id i3lock

    # kill focused window
    bindsym $mod+q kill

    # kill focused app
    bindsym $mod+Shift+q exec --no-startup-id ~/.local/bin/i3-kill-focused-app-windows

    # kill all app windows
    bindsym $mod+Shift+x exec --no-startup-id  i3-msg '[class=".*"] kill'

    # start rofi (a program launcher)
    bindcode $mod+40 exec "rofi -modi drun,run -show drun"

    # Launch rofi in window switching mode
    bindsym $mod+Shift+d exec "rofi -show window"

    # change focus
    bindsym $mod+h focus left
    bindsym $mod+j focus down
    bindsym $mod+k focus up
    bindsym $mod+l focus right

    # alternatively, you can use the cursor keys:
    bindsym $mod+Left focus left
    bindsym $mod+Down focus down
    bindsym $mod+Up focus up
    bindsym $mod+Right focus right

    # move focused window
    bindsym $mod+Shift+h move left
    bindsym $mod+Shift+j move down
    bindsym $mod+Shift+k move up
    bindsym $mod+Shift+l move right

    # alternatively, you can use the cursor keys:
    bindsym $mod+Shift+Left move left
    bindsym $mod+Shift+Down move down
    bindsym $mod+Shift+Up move up
    bindsym $mod+Shift+Right move right

    # split in horizontal orientation
    bindsym $mod+$alt+h split h

    # split in vertical orientation
    bindsym $mod+$alt+v split v

    # enter fullscreen mode for the focused container
    bindsym $mod+f fullscreen toggle

    # change container layout (stacked, tabbed, toggle split)
    bindsym $mod+s layout stacking
    bindsym $mod+w layout tabbed
    bindsym $mod+e layout toggle split

    # toggle tiling / floating
    bindsym $mod+Shift+space floating toggle

    # change focus between tiling / floating windows
    bindsym $mod+space focus mode_toggle

    # focus the parent container
    bindsym $mod+a focus parent

    # focus the child container
    #bindsym $mod+d focus child

    # reload the configuration file
    bindsym $mod+Shift+c reload
    # restart i3 inplace (preserves your layout/session, can be used to upgrade i3)
    bindsym $mod+Shift+r restart
    # Exit i3: Enter confirms logout; Escape cancels.
    bindsym $mod+Shift+e exec sh -c 'printf "%s\n" "Log out" | rofi -dmenu -no-custom -no-auto-select -selected-row 0 -p "Exit i3?" -mesg "Enter to log out; Escape to cancel" && i3-msg exit'

    # ScratchPad applications
    # Make the currently focused window a scratchpad
    bindsym $mod+Shift+minus move scratchpad

    # Show the first scratchpad window
    bindsym $mod+minus scratchpad show
#
# Workspaces:
#
    # Define workspaces
    workspace $ws1 output $center_monitor
    workspace $ws2 output $center_monitor
    workspace $ws3 output $center_monitor
    workspace $ws4 output $center_monitor
    workspace $ws5 output $center_monitor
    workspace $ws6 output $center_monitor
    workspace $ws7 output $center_monitor
    workspace $ws8 output $center_monitor
    workspace $ws9 output $center_monitor
    workspace $ws10 output $center_monitor

    # Switch to workspace
    bindsym $mod+1 workspace number $ws1
    bindsym $mod+2 workspace number $ws2
    bindsym $mod+3 workspace number $ws3
    bindsym $mod+4 workspace number $ws4
    bindsym $mod+5 workspace number $ws5
    bindsym $mod+6 workspace number $ws6
    bindsym $mod+7 workspace number $ws7
    bindsym $mod+8 workspace number $ws8
    bindsym $mod+9 workspace number $ws9
    bindsym $mod+0 workspace number $ws10

    # Move focused container to workspace
    bindsym $mod+Shift+1 move container to workspace number $ws1
    bindsym $mod+Shift+2 move container to workspace number $ws2
    bindsym $mod+Shift+3 move container to workspace number $ws3
    bindsym $mod+Shift+4 move container to workspace number $ws4
    bindsym $mod+Shift+5 move container to workspace number $ws5
    bindsym $mod+Shift+6 move container to workspace number $ws6
    bindsym $mod+Shift+7 move container to workspace number $ws7
    bindsym $mod+Shift+8 move container to workspace number $ws8
    bindsym $mod+Shift+9 move container to workspace number $ws9
    bindsym $mod+Shift+0 move container to workspace number $ws10

    # Define side workspaces
    workspace $ws_left output $left_monitor
    workspace $ws_right output $right_monitor

    # Switch to side workspace
    bindsym $mod+grave workspace $ws_left
    bindsym $mod+equal workspace $ws_right

    # Move focused container to side workspace
    bindsym $mod+Shift+grave move container to workspace $ws_left
    bindsym $mod+Shift+equal move container to workspace $ws_right

    # Workspace left and right start stacked, but I can override it later
    exec --no-startup-id i3-msg 'workspace $ws_left; layout stacked'
    exec --no-startup-id i3-msg 'workspace $ws_right; layout stacked'
#
# Applications:
#
    # Focus or Open Applications
    bindsym $mod+F1 \
        exec --no-startup-id \
            $focus_or_open_by_class \
                $zen_browser_cmd \
                $zen_browser_class
    bindsym $mod+F2 \
        exec --no-startup-id \
            $focus_or_open_by_class \
                $helium_cmd \
                $helium_class
    bindsym $mod+F5 \
        exec --no-startup-id \
            $focus_or_open_by_class \
                $proton_mail_cmd \
                $proton_mail_class, \
        workspace $ws5
    bindsym $mod+F7 \
        exec --no-startup-id \
            $focus_or_open_by_class \
                $lotion_cmd \
                $lotion_class, \
        workspace $ws7
    bindsym $mod+F8 \
        exec --no-startup-id \
            $focus_or_open_by_class \
                $calibre_cmd \
                $calibre_class, \
                workspace $ws_right
    bindsym $mod+F10 \
        exec --no-startup-id \
            $focus_or_open_by_title \
                $yazi_cmd \
                $yazi_title
    bindsym $mod+Shift+F10 \
        exec --no-startup-id \
            $focus_or_open_by_title \
                $vifm_cmd \
                $vifm_title
    bindsym $mod+F11 \
        exec --no-startup-id \
            $focus_or_open_by_class \
                $1password_cmd \
                $1password_class, \
                workspace $ws_right
    bindsym $mod+F12 \
        exec --no-startup-id \
            $focus_or_open_by_class \
                $proton_pass_cmd \
                $proton_pass_class, \
                workspace $ws_right

### Window behavior
#
# Layout:
#
    # Let i3 choose the default split direction based on workspace shape:
    # horizontal on wide workspaces, vertical on tall workspaces.
    default_orientation auto
#
# Mouse:
#
    # Use Mouse+$mod to drag floating windows to their wanted position
    floating_modifier $mod

    # move tiling windows via drag & drop by left-clicking into the title bar,
    # or left-clicking anywhere into the window while holding the floating modifier.
    tiling_drag modifier titlebar

### Window rules
#
# Workspace assignments:
#
    # Worspace_left (left_monitor)
    assign [class=$calculator_class] $ws_left
    assign [class=$kde_connect_sms_class] $ws_left
    assign [class=$proton_vpn_class] $ws_left
    assign [class=$teleprompter_class] $ws_left
    assign [class=$qprompt_class] $ws_left
    assign [class=$zoom_class] $ws_left

    # Workspace_right (right_monitor)
    assign [class=$1password_class] $ws_right
    assign [class=$calibre_class] $ws_right
    assign [class=$discord_class] $ws_right
    assign [class=$lotion_class] $ws_right
    assign [class=$proton_mail_class] $ws_right
    assign [class=$proton_pass_class] $ws_right
    assign [class=$youtube_class] $ws_right
    assign [class="Pavucontrol"] $ws_right

    # Numbered workspaces (center_monitor)
    assign [class=$librew/lf_class] workspace number $ws1
    assign [class=$zen_browser_class] workspace number $ws1

    assign [class=$steam_class] workspace number $ws10
    assign [class=$steam_app_class] workspace number $ws10
#
# Per-window rules
#
    # General rules
    for_window [class=".*"] border normal 3
    for_window [window_role="pop-up"] floating enable
    for_window [window_role="bubble"] floating enable
    for_window [window_role="dialog"] floating enable
    for_window [window_type="dialog"] floating enable

    # Application-specific rules
    for_window [class=$pika_backup_class] floating enable
    for_window [class="Pavucontrol"] floating enable

### Modes
#
    # resize window (you can also use the mouse for that)
    mode "resize" {
            # These bindings trigger as soon as you enter the resize mode

            # Pressing left will shrink the window’s width.
            # Pressing right will grow the window’s width.
            # Pressing up will shrink the window’s height.
            # Pressing down will grow the window’s height.
            bindsym h resize shrink width 10 px or 10 ppt
            bindsym k resize grow height 10 px or 10 ppt
            bindsym j resize shrink height 10 px or 10 ppt
            bindsym l resize grow width 10 px or 10 ppt

            # same bindings, but for the arrow keys
            bindsym Left resize shrink width 10 px or 10 ppt
            bindsym Up resize grow height 10 px or 10 ppt
            bindsym Down resize shrink height 10 px or 10 ppt
            bindsym Right resize grow width 10 px or 10 ppt

            # back to normal: Enter or Escape or $mod+r
            bindsym Return mode "default"
            bindsym Escape mode "default"
            bindsym $mod+r mode "default"
    }

    bindsym $mod+r mode "resize"

    # Settings mode
    mode "settings" {
        # poweroff
        bindsym $mod+Shift+p exec --no-startup-id poweroff

        # reboot
        bindsym $mod+Shift+r exec --no-startup-id reboot

        # turn on Redshift night-light mode
        bindsym $mod+n exec --no-startup-id ~/.local/bin/redshift-on

        bindsym $mod+Shift+n exec --no-startup-id ~/.local/bin/redshift-off

    	# back to normal: Enter or Escape or $mod+s
    	bindsym Return mode "default"
    	bindsym Escape mode "default"
    	bindsym $mod+Shift+c mode "default"
    }

    bindsym $mod+Shift+s mode "settings"

### Session services
#
# Autostart:
#
    # Start XDG autostart .desktop files using dex.
    # See: https://wiki.archlinux.org/index.php/XDG_Autostart
    exec --no-startup-id dex --autostart --environment i3
#
# Services:
#
    # Notification daemon
    exec --no-startup-id dunst

    # Lock the session before suspend
    exec --no-startup-id xss-lock --transfer-sleep-lock -- i3lock --nofork

    # Bluetooth tray applet
    exec --no-startup-id blueman-applet

    # NetworkManager tray applet
    exec --no-startup-id nm-applet

    # Automatically adjust screen color temperature based on time of day and location:
    exec --no-startup-id ~/.local/bin/redshift-on

    # Automatically chooses horizontal or vertical splits based on window dimensions
    exec --no-startup-id ~/.local/bin/autotiling
#
# Reload actions:
#
    # Reapply Rodecaster input volume when the config is reloaded
    exec_always --no-startup-id ~/.local/bin/set-rodecaster-input-volume
