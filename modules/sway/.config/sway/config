### Variables
#
    # Font (shared by title and bar)
    set $font pango:DejaVu Sans

    # Logo key. Use Mod1 for Alt.
    set $mod Mod4
    set $alt Mod1

    # Home row direction keys, like vim
    set $left h
    set $down j
    set $up k
    set $right l

    # Terminal emulator
    set $term ghostty

    # Application launcher. The wrapper asks Sway for the focused output before
    # opening the Wayland-native launcher there.
    set $menu ~/.local/bin/sway-focused-launcher

    # Application lancher - window search
    set $window_search rofi -window drun | xargs swaymsg exec --

    # Define names for default workspaces for which we configure key bindings later on.
    # We use variables to avoid repeating the names in multiple places.
    set $ws1 "1"
    set $ws2 "2"
    set $ws3 "3"
    set $ws4 "4"
    set $ws5 "5"
    set $ws6 "6"
    set $ws7 "7"
    set $ws8 "8"
    set $ws9 "9"
    set $ws10 "10"

    # Define names for non-numbered side workspaces
    set $ws_left left
    set $ws_right right


    # Application Command and Window Identifier Variables
    #   * Inspect Wayland app IDs with: swaymsg -t get_tree
    set $1password_cmd "1password"
    set $1password_app_id "(?i).*(1password|onepassword).*"

    set $battle_net_cmd "gtk-launch Battle.net"

    set $calculator_cmd "gnome-calculator"
    set $calculator_app_id "(?i).*calculator.*"

    set $calibre_cmd "calibre"
    set $calibre_app_id "(?i).*calibre.*"

    set $discord_cmd "flatpak run com.discordapp.Discord"
    set $discord_app_id "(?i).*discord.*"

    set $helium_cmd "helium"
    set $helium_app_id "(?i).*helium.*"

    set $ghostty_terminal_cmd "ghostty"
    set $ghostty_terminal_app_id "(?i).*ghostty.*"

    set $librewolf_cmd "librewolf"
    set $librewolf_app_id "(?i).*librewolf.*"

    set $lotion_cmd "lotion"
    set $lotion_app_id "(?i).*lotion.*"

    set $kde_connect_sms_cmd "kdeconnect-sms"
    set $kde_connect_sms_app_id "(?i).*kdeconnect\\.sms.*"

    set $pavucontrol_app_id "(?i).*pavucontrol.*"

    set $pika_backup_cmd "flatpak run org.gnome.World.PikaBackup"
    set $pika_backup_app_id "(?i).*pika.*backup.*"

    set $proton_mail_cmd "proton-mail"
    set $proton_mail_app_id "(?i).*proton.*mail.*"

    set $proton_pass_cmd "proton-pass"
    set $proton_pass_app_id "(?i).*proton.*pass.*"

    set $proton_vpn_cmd "protonvpn-app"
    set $proton_vpn_app_id "(?i).*proton.*vpn.*"

    set $qprompt_cmd "flatpak run com.cuperino.qprompt"
    set $qprompt_app_id "(?i).*qprompt.*"


    set $steam_cmd "steam"
    set $steam_app_id "(?i).*steam.*"

    set $steam_game_app_id "(?i).*steam_app_[0-9]+.*"

    set $teleprompter_cmd "flatpak run io.github.nokse22.teleprompter"
    set $teleprompter_app_id "(?i).*teleprompter.*"

    set $vifm_cmd "ghostty --title=vifm -e vifm"
    set $vifm_app_id "(?i).*ghostty.*"
    set $vifm_title "vifm"

    set $yazi_cmd "ghostty --title=yazi -e yazi"
    set $yazi_app_id "(?i).*ghostty.*"
    set $yazi_title "yazi"

    set $zen_browser_cmd "flatpak run app.zen_browser.zen"
    set $zen_browser_app_id "(?i).*zen.*"

    set $zoom_cmd "zoom"
    set $zoom_app_id "(?i).*zoom.*"

### Output configuration
#
