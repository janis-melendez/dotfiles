### Key bindings
#
# Basics:
#
    # PipeWire volume controls; work while the session is locked.
    bindsym --locked XF86AudioRaiseVolume exec --no-startup-id wpctl set-volume @DEFAULT_AUDIO_SINK@ 0.1+ -l 1.0
    bindsym --locked XF86AudioLowerVolume exec --no-startup-id wpctl set-volume @DEFAULT_AUDIO_SINK@ 0.1-
    bindsym --locked XF86AudioMute exec --no-startup-id wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle
    bindsym --locked XF86AudioMicMute exec --no-startup-id wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle

    # Start a terminal
    bindsym $mod+Return exec $term

    # Lock the screen
    bindsym $mod+$alt+l exec swaylock -f -c 000000

    # Power controls
    bindsym $mod+$alt+p exec --no-startup-id poweroff
    bindsym $mod+$alt+r exec --no-startup-id reboot

    # Kill focused window
    bindsym $mod+q kill

    # Start your launcher
    bindsym $mod+d exec $menu

    # Search through windows
    bindsym $mod+Shift+w exec $window_search

    # Drag floating windows by holding down $mod and left mouse button.
    # Resize them with right mouse button + $mod.
    # Despite the name, also works for non-floating windows.
    # Change normal to inverse to use left mouse button for resizing and right
    # mouse button for dragging.
    floating_modifier $mod normal

    # Reload the configuration file
    bindsym $mod+Shift+c reload

    # Exit Sway: select "Log out" to confirm; Escape cancels.
    bindsym $mod+Shift+e exec sh -c 'choice=$(printf "%s\n" "Log out" | ~/.local/bin/sway-focused-launcher --dmenu --prompt "Exit Sway? ") && [ "$choice" = "Log out" ] && swaymsg exit'

    # Clipboard history
    bindsym $mod+v exec cliphist list | rofi -dmenu -display-columns 2 | cliphist decode | wl-copy
#
# Moving around:
#
    # Move your focus around
    bindsym $mod+$left focus left
    bindsym $mod+$down focus down
    bindsym $mod+$up focus up
    bindsym $mod+$right focus right
    # Or use $mod+[up|down|left|right]
    bindsym $mod+Left focus left
    bindsym $mod+Down focus down
    bindsym $mod+Up focus up
    bindsym $mod+Right focus right

    # Move the focused window with the same, but add Shift
    bindsym $mod+Shift+$left move left
    bindsym $mod+Shift+$down move down
    bindsym $mod+Shift+$up move up
    bindsym $mod+Shift+$right move right
    # Ditto, with arrow keys
    bindsym $mod+Shift+Left move left
    bindsym $mod+Shift+Down move down
    bindsym $mod+Shift+Up move up
    bindsym $mod+Shift+Right move right
#
# Monitor / Workspace Outputs:
#
# Workspace-to-output routing is configured by
# ~/.local/libexec/sway/fix-monitors-sway after output layout is ready.
#
# Workspace Shortcuts:
#
    # Switch to workspace
    bindsym $mod+1 workspace number $ws1
    bindsym $mod+2 workspace number $ws2
    bindsym $mod+3 workspace number $ws3
    bindsym $mod+4 workspace number $ws4
    bindsym $mod+5 workspace number $ws5
    bindsym $mod+6 workspace number $ws6
    bindsym $mod+7 workspace number $ws7
    bindsym $mod+8 workspace number $ws8
    bindsym $mod+9 workspace number $ws9
    bindsym $mod+0 workspace number $ws10
    # Move focused container to workspace
    bindsym $mod+Shift+1 move container to workspace number $ws1
    bindsym $mod+Shift+2 move container to workspace number $ws2
    bindsym $mod+Shift+3 move container to workspace number $ws3
    bindsym $mod+Shift+4 move container to workspace number $ws4
    bindsym $mod+Shift+5 move container to workspace number $ws5
    bindsym $mod+Shift+6 move container to workspace number $ws6
    bindsym $mod+Shift+7 move container to workspace number $ws7
    bindsym $mod+Shift+8 move container to workspace number $ws8
    bindsym $mod+Shift+9 move container to workspace number $ws9
    bindsym $mod+Shift+0 move container to workspace number $ws10
    # Note: workspaces can have any name you want, not just numbers.
    # We just use 1-10 as the default.

    # Switch to side workspace
    bindsym $mod+grave workspace $ws_left
    bindsym $mod+equal workspace $ws_right

    # Move focused container to side workspace
    bindsym $mod+Shift+grave move container to workspace $ws_left
    bindsym $mod+Shift+equal move container to workspace $ws_right

    # Side workspaces are created and placed after output layout setup in
    # ~/.local/libexec/sway/fix-monitors-sway.
#
# Opening applications:
#
    # Zen browser
    bindsym $mod+F1 \
        exec --no-startup-id $zen_browser_cmd
    # Helium Browser
    bindsym $mod+F2 \
        exec --no-startup-id $helium_cmd,
            workspace $ws2
    # Steam
    bindsym $mod+F3 \
        exec --no-startup-id $steam_cmd,
            workspace number $ws10
    # Battle.net (Steam/Proton)
    bindsym $mod+F4 \
        exec --no-startup-id $battle_net_cmd,
            workspace number $ws10
    # Proton Mail
    bindsym $mod+F5 \
        exec --no-startup-id $proton_mail_cmd,
            workspace $ws5
    # Notion
    bindsym $mod+F7 \
        exec --no-startup-id $lotion_cmd,
            workspace $ws7
    # Calibre
    bindsym $mod+F8 \
        exec --no-startup-id $calibre_cmd,
                workspace $ws_right
    # Yazi File Browser
    bindsym $mod+F10 \
        exec --no-startup-id $yazi_cmd
    # 1Password
    bindsym $mod+F11 \
        exec --no-startup-id $1password_cmd,
            workspace $ws_right
    # Proton Pass
    bindsym $mod+F12 \
        exec --no-startup-id $proton_pass_cmd,
            workspace $ws_right
#
# Layout stuff:
#
    # You can "split" the current object of your focus with
    # $mod+b or $mod+v, for horizontal and vertical splits
    # respectively.
    # bindsym $mod+b splith
    # bindsym $mod+v splitv

    # Switch the current container between different layout styles
    bindsym $mod+s layout stacking
    bindsym $mod+w layout tabbed
    bindsym $mod+e layout toggle split

    # Make the current focus fullscreen
    bindsym $mod+f fullscreen

    # Toggle the current focus between tiling and floating mode
    bindsym $mod+Shift+space floating toggle

    # Swap focus between the tiling area and the floating area
    bindsym $mod+space focus mode_toggle

    # Move focus to the parent container
    bindsym $mod+a focus parent
#
# Scratchpad:
#
    # Sway has a "scratchpad", which is a bag of holding for windows.
    # You can send windows there and get them back later.

    # Move the currently focused window to the scratchpad
    bindsym $mod+Shift+minus move scratchpad

    # Show the next scratchpad window or hide the focused scratchpad window.
    # If there are multiple scratchpad windows, this command cycles through them.
    bindsym $mod+minus scratchpad show

### Window rules
#
# Workspace assignments:
#
    # workspace_left (left_monitor)
    assign [app_id=$calculator_app_id] $ws_left
    assign [app_id=$kde_connect_sms_app_id] $ws_left
    assign [app_id=$proton_vpn_app_id] $ws_left
    assign [app_id=$teleprompter_app_id] $ws_left
    assign [app_id=$qprompt_app_id] $ws_left
    assign [app_id=$zoom_app_id] $ws_left

    # workspace_right (right_monitor)
    assign [app_id=$1password_app_id] $ws_right
    assign [app_id=$calibre_app_id] $ws_right
    assign [app_id=$discord_app_id] $ws_right
    assign [app_id=$lotion_app_id] $ws_right
    assign [app_id=$pavucontrol_app_id] $ws_right
    assign [app_id=$proton_mail_app_id] $ws_right
    assign [app_id=$proton_pass_app_id] $ws_right

    # numbered workspaces (center_monitor)
    assign [app_id=$librewolf_app_id] workspace number $ws1
    assign [app_id=$zen_browser_app_id] workspace number $ws1

    # Steam itself and every Steam/Proton game open on workspace 10.
    assign [app_id=$steam_app_id] workspace number $ws10
    assign [app_id=$steam_game_app_id] workspace number $ws10
#
# Per-window rules:
#
    # General applications rules
    for_window [app_id=".*"] border normal 3
    for_window [window_role="pop-up"] floating enable
    for_window [window_role="bubble"] floating enable
    for_window [window_role="dialog"] floating enable
    for_window [window_type="dialog"] floating enable

    # Application-specific rules
    for_window [app_id=$pika_backup_app_id] floating enable
    for_window [app_id=$pavucontrol_app_id] floating enable
    for_window [app_id="(?i).*zenity.*"] floating enable

### Modes
#
    mode "resize" {
        # left will shrink the containers width
        # right will grow the containers width
        # up will shrink the containers height
        # down will grow the containers height
        bindsym $left resize shrink width 10px
        bindsym $down resize grow height 10px
        bindsym $up resize shrink height 10px
        bindsym $right resize grow width 10px

        # Ditto, with arrow keys
        bindsym Left resize shrink width 10px
        bindsym Down resize grow height 10px
        bindsym Up resize shrink height 10px
        bindsym Right resize grow width 10px

        # Return to default mode
        bindsym Return mode "default"
        bindsym Escape mode "default"
    }
    bindsym $mod+r mode "resize"

    mode "settings" {
        # poweroff
        bindsym $mod+Shift+p exec --no-startup-id poweroff

        # reboot
        bindsym $mod+Shift+r exec --no-startup-id reboot

        # Return to default mode
        bindsym Return mode "default"
        bindsym Escape mode "default"
        bindsym $mod+Shift+c mode "default"
    }
    bindsym $mod+Shift+s mode "settings"

### Session services
#
# Environment:
#
    # import variables into system-user enviroment
    # based on the instructions in the sway wiki
    # see also https://github.com/swaywm/sway/issues/5732
    # and https://github.com/systemd/systemd/blob/dfc637d0ff756889e8e5b7cb4ec991eb06069aa1/xorg/50-systemd-user.sh
    exec systemctl --user import-environment \
        DISPLAY WAYLAND_DISPLAY SWAYSOCK

    exec hash dbus-update-activation-environment 2>/dev/null && \
            dbus-update-activation-environment --systemd \
                DISPLAY WAYLAND_DISPLAY SWAYSOCK XDG_CURRENT_DESKTOP=sway
#
# Setup:
#
    # Wallpaper
    exec swaybg \
        -o "*" \
        -i "$HOME/.local/share/wallpapers/dark-mountain-landscape.jpg" \
        -m fill
#
# Services:
#
    # Make inactive windows transparent
    exec ~/.local/libexec/sway/inactive_windows_transparent

    # Starts the Waybar status bar
    exec waybar

    # Notification daemon
    # exec mako
    exec dunst

    # Network
    exec nm-applet

    # Bluetooth
    exec blueman-applet

    # Starts clipboard history watcher
    exec wl-paste --watch cliphist store

    # Adjust color temperature on the configured day/night schedule
    exec ~/.local/bin/sunset.sh on

    # Automatically chooses horizontal or vertical splits based on window dimensions
    exec ~/.local/bin/autotiling

    # Idle handling and screen locking
    exec swayidle -w \
             timeout 300 'swaylock -f -c 000000' \
             timeout 600 'swaymsg "output * power off"' resume 'swaymsg "output * power on"' \
             before-sleep 'swaylock -f -c 000000'
#
# Reload actions:
#
    # Reapply Rodecaster input volume when the config is reloaded
    exec_always --no-startup-id ~/.local/bin/set-rodecaster-input-volume

    # Applies the configured monitor layout after Sway starts
    exec_always ~/.local/libexec/sway/fix-monitors-sway
