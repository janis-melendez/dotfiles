[global]
    # Display notifications near the active window, not on a fixed monitor.
    follow = keyboard
    origin = top-right
    offset = 24x24
    width = (360, 460)
    height = 300
    notification_limit = 4
    indicate_hidden = yes

    # Keep notifications readable without dominating the screen.
    font = DejaVu Sans 13
    line_height = 3
    format = "<b>%s</b>\n%b"
    markup = full
    alignment = left
    vertical_alignment = center
    ellipsize = middle
    show_age_threshold = 60
    word_wrap = yes

    # Dark Nord visual treatment, aligned with the Niri desktop.
    background = "#2E3440"
    foreground = "#E5E9F0"
    frame_color = "#88C0D0"
    frame_width = 2
    corner_radius = 12
    gap_size = 10
    padding = 14
    horizontal_padding = 16
    text_icon_padding = 12
    icon_position = left
    min_icon_size = 32
    max_icon_size = 64
    icon_corner_radius = 8
    icon_theme = Papirus-Dark, Papirus, hicolor
    # Resolve named icons from the installed Papirus icon themes.
    enable_recursive_icon_lookup = true

    progress_bar = true
    progress_bar_height = 8
    progress_bar_frame_width = 0
    progress_bar_corner_radius = 4
    progress_bar_min_width = 150
    progress_bar_max_width = 360

    # Use Dunst's native Wayland layer-shell support when available.
    layer = overlay
    force_xwayland = false

    # Click a notification to activate its action; dismiss it with right click.
    mouse_left_click = do_action
    mouse_middle_click = close_current
    mouse_right_click = close_all

[urgency_low]
    background = "#3B4252"
    foreground = "#D8DEE9"
    frame_color = "#4C566A"
    timeout = 5

[urgency_normal]
    background = "#2E3440"
    foreground = "#E5E9F0"
    frame_color = "#88C0D0"
    timeout = 8

[urgency_critical]
    background = "#BF616A"
    foreground = "#ECEFF4"
    frame_color = "#EBCB8B"
    timeout = 0
