#!/usr/bin/env bash

set -euo pipefail

PRIMARY_DISPLAY="DisplayPort-0"
SECONDARY_DISPLAY="DisplayPort-1"
MAX_OUTPUT_WAIT_SECONDS=10

wait_for_connected_output() {
  local output="$1"
  local attempt

  for ((attempt = 1; attempt <= MAX_OUTPUT_WAIT_SECONDS; attempt++)); do
    if xrandr --query | awk -v output="$output" '
      $1 == output && $2 == "connected" { found = 1 }
      END { exit !found }
    '; then
      return 0
    fi

    sleep 1
  done

  printf 'Timed out waiting for connected output: %s\n' "$output" >&2
  return 1
}

wait_for_connected_output "$PRIMARY_DISPLAY"
wait_for_connected_output "$SECONDARY_DISPLAY"

HDMI_OUTPUT="$(
    xrandr --query |
        awk '/^HDMI.* connected/ { print $1; exit }'
)"

# Primary monitor
xrandr --output "$PRIMARY_DISPLAY" \
  --primary \
  --mode 2560x1440 \
  --rate 144.00 \
  --rotate normal

# Right portrait monitor
xrandr --output "$SECONDARY_DISPLAY" \
  --mode 2560x1440 \
  --rate 60.00 \
  --rotate right \
  --right-of "$PRIMARY_DISPLAY"

# Left HDMI monitor
if [ -n "$HDMI_OUTPUT" ]; then
  xrandr --output "$HDMI_OUTPUT" \
    --mode 1024x576 \
    --rate 60.00 \
    --reflect y \
    --left-of "$PRIMARY_DISPLAY"
fi

# Set wallpaper
wallpaper="$HOME/.local/share/wallpapers/dark-mountain-landscape.jpg"

# Set all outputs to the same wallpaper
feh --bg-fill "$wallpaper"
